{
  "name": "ascii-art-effects-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASCII Art Effects: strona w przeglądarce (Vite + TypeScript, bez frameworka UI).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.ts",
    "smoke": "node scripts/smoke.ts",
    "test:engine": "node scripts/browser-engine.ts",
    "fixtures": "node scripts/gen-dev-fixtures.ts",
    "test:ui": "node scripts/ui-check.ts",
    "thumbs": "node scripts/thumbs.ts"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-mono": "^5.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
